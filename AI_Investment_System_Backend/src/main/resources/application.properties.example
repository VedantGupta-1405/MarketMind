spring.application.name=investment-system

# PostgreSQL
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/investment_system}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:YOUR_POSTGRES_PASSWORD}

# Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Server
server.port=${PORT:${SERVER_PORT:8080}}

# ML Service
ml.service.url=${ML_SERVICE_URL:http://localhost:8000}

# Finnhub Market Data API
finnhub.api-key=${FINNHUB_API_KEY:YOUR_FINNHUB_API_KEY}
finnhub.base-url=https://finnhub.io/api/v1